<div class="card voice-session-card">
  <div class="session-top-row">
    <div class="server-info">
      <% if (state && state.guildIconURL) { %>
        <img src="<%= state.guildIconURL %>" alt="Server Icon" class="server-icon-img">
      <% } else { %>
        <div class="server-icon-placeholder">
          <%= (state && state.guildName) ? state.guildName.charAt(0).toUpperCase() : 'D' %>
        </div>
      <% } %>
      <div class="server-text-details">
        <div class="server-title"><%= (state && state.guildName) ? state.guildName : 'Discord Server' %></div>
        <div class="channel-subtitle">
          <svg class="vc-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M3 18v-6a9 9 0 0 1 18 0v6"></path>
            <path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"></path>
          </svg>
          <%= (state && state.channelName) ? state.channelName : 'Voice Channel' %>
        </div>
      </div>
    </div>
    <span class="live-pill">● Live</span>
  </div>

  <div class="voice-controls-bar">
    <form action="/voice/mute" method="POST" style="display:inline;">
      <button type="submit" class="btn-audio <%= (typeof muted !== 'undefined' && muted) ? 'active' : '' %>" title="<%= (typeof muted !== 'undefined' && muted) ? 'Unmute Mic' : 'Mute Mic' %>">
        <svg class="audio-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"></path>
          <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
          <line x1="12" y1="19" x2="12" y2="23"></line>
          <line x1="8" y1="23" x2="16" y2="23"></line>
          <% if (typeof muted !== 'undefined' && muted) { %>
            <line x1="1" y1="1" x2="23" y2="23" stroke="#EF4444" stroke-width="2.5"></line>
          <% } %>
        </svg>
        <span><%= (typeof muted !== 'undefined' && muted) ? 'Muted' : 'Mic Active' %></span>
      </button>
    </form>

    <form action="/voice/deafen" method="POST" style="display:inline;">
      <button type="submit" class="btn-audio <%= (typeof deafened !== 'undefined' && deafened) ? 'active' : '' %>" title="<%= (typeof deafened !== 'undefined' && deafened) ? 'Undeafen' : 'Deafen' %>">
        <svg class="audio-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M3 18v-6a9 9 0 0 1 18 0v6"></path>
          <path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"></path>
          <% if (typeof deafened !== 'undefined' && deafened) { %>
            <line x1="1" y1="1" x2="23" y2="23" stroke="#EF4444" stroke-width="2.5"></line>
          <% } %>
        </svg>
        <span><%= (typeof deafened !== 'undefined' && deafened) ? 'Deafened' : 'Deafen' %></span>
      </button>
    </form>
  </div>

  <div class="session-bottom-actions">
    <button type="button" class="btn btn-ghost" onclick="toggleSwitchChannelOverlay()">Switch Channel</button>
    <a href="/leave" class="btn btn-danger-outline">Leave VC</a>
  </div>

  <div class="switch-channel-overlay" id="switchChannelOverlay" style="display: none;">
    <form action="/join" method="POST" class="voice-join-form">
      <div class="form-row-pair">
        <div class="form-group">
          <label class="form-label">GUILD ID</label>
          <input type="text" name="guildId" class="form-input" value="<%= (history && history.guildId) ? history.guildId : '' %>" required>
        </div>
        <div class="form-group">
          <label class="form-label">CHANNEL ID</label>
          <input type="text" name="channelId" class="form-input" value="<%= (history && history.channelId) ? history.channelId : '' %>" required>
        </div>
      </div>
      <div class="form-actions-right">
        <button type="button" class="btn btn-ghost" onclick="toggleSwitchChannelOverlay()">Cancel</button>
        <button type="submit" class="btn btn-accent">Switch VC</button>
      </div>
    </form>
  </div>
</div>

<script>
function toggleSwitchChannelOverlay() {
  const overlay = document.getElementById('switchChannelOverlay');
  if (!overlay) return;
  overlay.style.display = overlay.style.display === 'none' ? 'block' : 'none';
}
</script>
